{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-pro",
  "small_model": "opencode-go/gpt-5.6-luna",
  "default_agent": "build",
  "disabled_providers": [
    "opencode"
  ],
  "autoupdate": "notify",
  "snapshot": false,
  "share": "disabled",
  "compaction": {
    "auto": true,
    "prune": false,
    "tail_turns": 2,
    "reserved": 10000
  },
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 16384
  },
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.git/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/target/**",
      "**/.next/**",
      "**/.nuxt/**",
      "**/.turbo/**",
      "**/.venv/**",
      "**/venv/**",
      "**/__pycache__/**",
      "**/.cache/**",
      "**/coverage/**",
      "**/vendor/**",
      "**/.opencode/**"
    ]
  },
  "lsp": true,
  "formatter": true,
  "experimental": {
    "batch_tool": true,
    "mcp_timeout": 10000
  },
  "agent": {
    "build": {
      "model": "opencode-go/deepseek-v4-pro",
      "mode": "primary",
      "temperature": 0,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "external_directory": "allow"
      }
    },
    "plan": {
      "model": "opencode-go/kimi-k3",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "external_directory": "allow"
      }
    },
    "explore": {
      "model": "opencode-go/gpt-5.6-luna",
      "temperature": 0,
      "description": "USA ESTO CUANDO haya que localizar algo en el repo y no sepas dónde está: dónde se usa un símbolo, qué ficheros tocan una feature, si existe ya algo parecido, o cuando la búsqueda cruce muchos ficheros o varias convenciones de nombres. Devuelve rutas y hallazgos, no volcados de ficheros. No: leer un fichero que ya sabes cuál es (hazlo tú), ni editar nada.",
      "permission": {
        "tandem_*": "deny",
        "external_directory": "allow"
      }
    },
    "general": {
      "disable": true
    }
  },
  "provider": {
    "opencode": {
      "options": {
        "setCacheKey": true,
        "headerTimeout": 70000,
        "timeout": 300000
      }
    },
    "opencode-go": {
      "options": {
        "setCacheKey": true,
        "headerTimeout": 70000,
        "timeout": 300000
      }
    }
  },
  "mcp": {}
}
